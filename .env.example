# OpenRouter API (for prompt enhancement)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# fal.ai API (default backend for Stage 2 raster generation)
FAL_KEY=your-fal-key-here

# Optional: override backend ("fal" or "local"). CLI --local-flux takes precedence.
# TXT2PLOTTER_BACKEND=fal

# HuggingFace (only required when using --local-flux for gated Flux.2-dev access)
HF_TOKEN=hf_your-token-here
